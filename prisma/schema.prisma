// Prisma schema for Dieta Maite
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USUARIA
  ADMIN
}

enum Weekday {
  LUNES
  MARTES
  MIERCOLES
  JUEVES
  VIERNES
  SABADO
  DOMINGO
}

enum MealType {
  DESAYUNO
  ALMUERZO
  COMIDA
  COMIDA_LIBRE_SOCIAL
  CENA
}

enum LogSource {
  PLANIFICADO
  LIBRE
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  role         Role
  createdAt    DateTime @default(now())

  profile       Profile?
  dayTypes      DayType[]
  dayPlans      DayPlan[]
  mealLogs      MealLog[]
  exerciseLogs  ExerciseLog[]
  weightLogs    WeightLog[]
}

/// Datos antropométricos y objetivos calóricos (uno por usuaria, editable por el admin).
/// La proteína y la grasa objetivo son constantes: no cambian según el día.
model Profile {
  id                     String   @id @default(cuid())
  userId                 String   @unique
  user                   User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  sexo                   String
  edad                   Int
  alturaCm               Int
  pesoInicialKg          Float
  pesoObjetivoKg         Float
  bmrKcal                Int
  factorActividad        Float
  getKcal                Int
  deficitDiarioKcal      Int
  objetivoProteinaG      Int
  objetivoGrasasG        Int
  presupuestoSemanalKcal Int
  updatedAt              DateTime @updatedAt
}

/// Tipo de día definido por la usuaria/admin (p.ej. "Entrenamiento", "Descanso"),
/// cada uno con su propio objetivo de carbohidratos. La proteína y la grasa
/// objetivo no van aquí: son constantes en Profile para todos los días.
model DayType {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  nombre         String
  carbohidratosG Int
  updatedAt      DateTime @updatedAt

  dayPlans DayPlan[]

  @@unique([userId, nombre])
}

/// Plan de un día de la semana para una usuaria concreta: qué tipo de día es
/// (de donde sale el objetivo de carbohidratos; kcal se calcula a partir de
/// proteína+carbohidratos+grasa).
model DayPlan {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  weekday   Weekday
  dayTypeId String
  dayType   DayType  @relation(fields: [dayTypeId], references: [id])
  updatedAt DateTime @updatedAt

  comidas PlannedMeal[]

  @@unique([userId, weekday])
}

/// Plato planificado del menú semanal para un día y una comida concretos
model PlannedMeal {
  id                String   @id @default(cuid())
  dayPlanId         String
  dayPlan           DayPlan  @relation(fields: [dayPlanId], references: [id], onDelete: Cascade)
  mealType          MealType
  descripcion       String   @db.Text
  kcal              Int
  proteinaG         Float
  carbohidratosG    Float
  grasasG           Float
  updatedAt         DateTime @updatedAt

  mealLogs MealLog[]

  @@unique([dayPlanId, mealType])
}

/// Registro real de una comida consumida por la usuaria
model MealLog {
  id             String    @id @default(cuid())
  userId         String
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  fecha          DateTime  @db.Date
  mealType       MealType
  source         LogSource
  plannedMealId  String?
  plannedMeal    PlannedMeal? @relation(fields: [plannedMealId], references: [id], onDelete: SetNull)
  nombre         String
  kcal           Int
  proteinaG      Float
  carbohidratosG Float
  grasasG        Float
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([userId, fecha])
}

/// Alimento de referencia (tabla de composición), valores por 100 g de porción
/// comestible. Compartida por todas las usuarias, usada para autorrellenar
/// kcal/macros al elegir un alimento y una cantidad en gramos.
model Food {
  id             String @id @default(cuid())
  nombre         String
  /// nombre en minúsculas y sin tildes, para que la búsqueda encuentre
  /// "platano" al buscar "PLÁTANO" sin depender de extensiones de Postgres
  busqueda       String
  categoria      String
  kcal           Int
  proteinaG      Float
  carbohidratosG Float
  grasasG        Float

  @@unique([nombre, categoria])
  @@index([categoria])
  @@index([busqueda])
}

/// Tabla de equivalentes metabólicos (MET) por tipo de ejercicio
model ExerciseType {
  id     String @id @default(cuid())
  nombre String @unique
  met    Float
  orden  Int    @default(0)

  exerciseLogs ExerciseLog[]
}

/// Sesión de ejercicio registrada por la usuaria
model ExerciseLog {
  id             String       @id @default(cuid())
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  fecha          DateTime     @db.Date
  exerciseTypeId String
  exerciseType   ExerciseType @relation(fields: [exerciseTypeId], references: [id])
  minutos        Int
  pesoUsadoKg    Float
  kcalQuemadas   Float
  createdAt      DateTime     @default(now())

  @@index([userId, fecha])
}

/// Registro periódico de peso de la usuaria
model WeightLog {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  fecha     DateTime @db.Date
  pesoKg    Float
  createdAt DateTime @default(now())

  @@unique([userId, fecha])
  @@index([userId, fecha])
}
