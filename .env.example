# URL de conexión a PostgreSQL (Neon, Supabase, Railway, o local)
DATABASE_URL="postgresql://usuario:password@host:5432/basededatos?schema=public&sslmode=require"

# Secreto usado para firmar las cookies de sesión (genera uno con: openssl rand -base64 32)
AUTH_SECRET="cambia-este-valor-por-uno-aleatorio-y-largo"

# Contraseñas iniciales para el seed (solo se usan la primera vez que se puebla la BD)
SEED_MAITE_EMAIL="maite@example.com"
SEED_MAITE_PASSWORD="cambia-esta-password"
SEED_SIMON_EMAIL="simon@example.com"
SEED_SIMON_PASSWORD="cambia-esta-password"

# Claves VAPID para notificaciones push (recordatorios diarios). Genera un par
# propio con: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY="clave-publica-vapid"
VAPID_PRIVATE_KEY="clave-privada-vapid"

# Secreto que protege /api/cron/recordatorios (Vercel Cron lo envía como
# "Authorization: Bearer <CRON_SECRET>" automáticamente si defines esta
# variable en el proyecto de Vercel).
CRON_SECRET="genera-un-secreto-aleatorio"
